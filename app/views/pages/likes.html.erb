<div class="container">

  <h1 class="mb-4 text-center">All your favorites</h1>

  <% if @media.present? %>
    <div class="row d-desktop">
        <% @media.each do |medium| %>
          <%= render "shared/cards/card_desktop", medium: medium %>
        <% end %>
    </div>

    <div class="row d-mobile">
        <% @media.each do |medium| %>
          <%= render "shared/cards/card_mobile", medium: medium %>
        <% end %>
    </div>

  <% else %>
    <p>Like your first media !</p>
  <% end %>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @media %>
  </div>

</div>
