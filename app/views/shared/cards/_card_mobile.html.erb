<%# Display for mobile %>
<div class="search-media-cards col-md-3 mb-3 mt-3">

  <%# Image %>
  <div class="search-card-image">
    <% if medium["poster_url"] != "N/A" && medium["poster_url"]%>
      <%= image_tag medium["poster_url"], alt: medium["title"], class: "search-card-image-left" %>
    <% else %>
      <div class="bg-secondary text-light d-flex align-items-center justify-content-center" style="height: 200px; width: 140px;">
        No Poster
      </div>
    <% end %>
  </div>

  <%# Texte %>
  <div class="search-card-body d-flex flex-column justify-content-between">
    <h5 class="card-title"><%= medium["title"] %></h5>
    <p class="card-text"><%= medium["year"] %> -
      <% if medium["sub_media_type"] == "Movie" %>
        <i class="fa-solid fa-video" style="color: #ffffffff; margin-right: 12px;"></i>
      <% elsif medium["sub_media_type"] == "Book" %>
        <i class="fa-solid fa-book-open" style="color: #ffffffff; margin-right: 12px;"></i>
      <% else %>
        <i class="fa-solid fa-gamepad" style="color: #ffffffff; margin-right: 12px;"></i>
      <% end %>
    </p>

    <% if defined?(review) %>
      <p class="review-card-text"><strong>Your review :</strong> <em><%= review.content %></em></p>
      <p class="review-rating"><%= review.rating %> <i class="fa-solid fa-star" style="color: #FBC500;"></i></p>
    <% else %>
      <%# buttons %>
      <div class="list-icon">
        <%= render "shared/buttons/collection_button", medium: medium, location: "card"  %>
        <%= render "shared/buttons/like_button", medium: medium, location: "card"  %>
        <%= render "shared/buttons/next_up_button", medium: medium, location: "card"  %>
      </div>

      <div class="btn-more-details">
        <%= link_to "More details", medium_path(medium),
          class: "btn btn-primary rounded-pill" %>
      </div>
    <% end %>
  </div>
</div>
