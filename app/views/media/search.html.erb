<div class="container">

  <h1 class="mb-4">
    Results for "<%= params[:title] %>"
  </h1>

  <%= link_to "← New search", media_path, class: "btn btn-link mb-3" %>

  <%# For Desktop, we want to display everything %>
  <div class="d-desktop">
    <% if @results_all.present? %>
      <div class="row">
        <% @results_all.each do |result| %>
          <%# Display for desktop %>
          <%= render "shared/cards/card_desktop", medium: result  %>
        <% end %>
      </div>
    <% else %>
      <p>No results found.</p>
    <% end %>
  </div>

  <%# For Mobile, we want to paginate the content %>
  <div class="d-mobile">
    <% if @results_paginated.present? %>
      <div class="row">
        <% @results_paginated.each do |result| %>
          <%# Display for mobile %>
          <%= render "shared/cards/card_mobile", medium: result  %>
        <% end %>
      </div>

      <div class="d-mobile">
        <div class="d-flex justify-content-center mt-4">
          <%= link_to_prev_page @results_paginated, '<< Previous Page', params: { medium_type: params[:medium_type], title: params[:title] } %>
          <%= link_to_next_page @results_paginated, 'Next Page >>', params: { medium_type: params[:medium_type], title: params[:title] } %>
        </div>
      </div>
    <% else %>
      <p>No results found.</p>
    <% end %>
  </div>
</div>
