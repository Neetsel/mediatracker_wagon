<div class="container">

  <h1 class="mb-4 text-center">Your collection</h1>

  <% if @collections.present? %>
    <div class="row d-desktop">
      <% @collections.each do |collection| %>
        <%= render "shared/cards/card_desktop", medium: collection.medium %>
      <% end %>
    </div>

    <div class="row d-mobile">
      <% @collections.each do |collection| %>
        <%= render "shared/cards/card_mobile", medium: collection.medium %>
      <% end %>
    </div>
  <% else %>
    <p>Start your collection now !</p>
  <% end %>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @collections %>
  </div>

</div>
