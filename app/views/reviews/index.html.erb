<div class="container">

  <h1 class="mb-4 text-center">Your review</h1>

  <% if @reviews.present? %>

    <div class="row d-desktop">
        <% @reviews.each do |review| %>
          <%= render "shared/cards/card_desktop", medium: review.medium, review: review %>
        <% end %>
    </div>

    <div class="row d-mobile">
        <% @reviews.each do |review| %>
          <%= render "shared/cards/card_mobile", medium: review.medium, review: review %>
        <% end %>
    </div>

  <% else %>
    <p>Write your first review !</p>
  <% end %>


  <div class="d-flex justify-content-center mt-4">
    <%= paginate @reviews %>
  </div>

</div>
