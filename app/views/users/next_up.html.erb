<div class="container">

  <h1 class="mb-4 text-center">Your Next Up Media</h1>

  <% if @next_up_media.present? %>

    <div class="row d-desktop">
        <% @next_up_media.each do |medium| %>
          <%= render "shared/cards/card_desktop", medium: medium %>
        <% end %>
    </div>

    <div class="row d-mobile">
        <% @next_up_media.each do |medium| %>
          <%= render "shared/cards/card_mobile", medium: medium %>
        <% end %>
    </div>

  <% else %>
    <p>Add the medium you want to explore !</p>
  <% end %>


  <div class="d-flex justify-content-center mt-4">
    <%= paginate @next_up_media %>
  </div>

</div>
